#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Take down the s6 supervision tree when the gateway fails, following the
# official Home Assistant add-ons (samba/smbd). s6 passes the exit code in $1,
# or 256 with the signal number in $2 if the service was killed by a signal.
# uvicorn re-raises SIGTERM after its graceful shutdown, so every normal stop
# ends as "killed by signal 15" (143 in a shell): halt, but keep exit code 0.
# ==============================================================================
# shellcheck disable=SC2155
readonly exit_code_container=$(</run/s6-linux-init-container-results/exitcode)
readonly exit_code_service="${1}"
readonly exit_code_signal="${2}"

bashio::log.info \
  "Service myha exited with code ${exit_code_service}" \
  "(by signal ${exit_code_signal})"

if [[ "${exit_code_service}" -eq 256 ]]; then
  # Any other signal (OOM kill, crash) is recorded as a failure; s6 restarts the service.
  if [[ "${exit_code_signal}" -ne 15 && "${exit_code_container}" -eq 0 ]]; then
    echo $((128 + exit_code_signal)) > /run/s6-linux-init-container-results/exitcode
  fi
  [[ "${exit_code_signal}" -eq 15 ]] && exec /run/s6/basedir/bin/halt
elif [[ "${exit_code_service}" -ne 0 ]]; then
  if [[ "${exit_code_container}" -eq 0 ]]; then
    echo "${exit_code_service}" > /run/s6-linux-init-container-results/exitcode
  fi
  exec /run/s6/basedir/bin/halt
fi
