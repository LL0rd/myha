{
  "name": "myha-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.guest.config.ts",
    "dev:admin": "vite --config vite.admin.config.ts --open /admin.html",
    "build": "vite build --config vite.guest.config.ts && vite build --config vite.admin.config.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc"
  },
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@tabler/icons-react": "^3.49.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
